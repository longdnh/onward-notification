# Copy sang .env rồi chỉnh theo máy của bạn. Mọi biến đều có giá trị mặc định
# trong internal/config/config.go; bỏ trống hoặc bỏ dòng để dùng mặc định.
#
# Ứng dụng KHÔNG tự đọc file .env. Nó được nạp bởi direnv (.envrc có
# dotenv_if_exists .env), hoặc tự nạp bằng: set -a; source .env; set +a

# --- RabbitMQ ---
# Exchange do service Account sở hữu và khai báo. Service này chỉ bind queue vào
# exchange đó với routing key "auth.#".
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=onward.auth
RABBITMQ_QUEUE=notification.auth-mail
# Số message chưa ack tối đa được đẩy cho consumer cùng lúc (>= 1).
RABBITMQ_PREFETCH=10

# --- SMTP ---
# Local dùng Mailpit (không auth, không TLS). Xem mail tại http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@onward.local

# --- Frontend ---
# Gốc URL cho link trong mail: <FRONTEND_BASE_URL>/verify-email?token=...
# và <FRONTEND_BASE_URL>/reset-password?token=... Phải là URL http(s) tuyệt đối.
FRONTEND_BASE_URL=http://localhost:5173

# --- Redis (chống xử lý trùng message) ---
REDIS_ADDR=localhost:6379
# Thời gian nhớ một messageId đã xử lý. Tối thiểu 1m và phải lớn hơn
# thời hạn sống dài nhất của token.
DEDUP_TTL=48h
